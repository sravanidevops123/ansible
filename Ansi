- name: Fetch file metadata from GCS bucket
  hosts: localhost
  tasks:
    - name: Get metadata of the zip file
      gcp_storage_object_info:
        bucket: "your-bucket-name"
        object_name: "your-zip-file.zip"
        auth_kind: "serviceaccount"
        service_account_file: "/path/to/your-service-account-key.json"
      register: zip_file_info

    - name: Show the timestamp of the zip file
      debug:
        msg: "The zip file was last updated at {{ zip_file_info.objects[0].updated }}"
